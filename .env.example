NODE_ENV=development
PORT=3000
DEBUG=false

# Redis. Use a local Redis for development. REDISCLOUD_URL takes precedence over
# REDIS_HOST, so leave it empty unless you mean to connect to a deployed Redis
# (a local worker on stage/alpha Redis takes jobs from the deployed worker).
REDISCLOUD_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend. Stage: https://api-stage.infinidream.ai/api/v1
BACKEND_URL=http://localhost:8080/api/v1
BACKEND_API_KEY=
INTERNAL_API_KEY=

# fal
FAL_KEY=

# RunPod: API key plus one serverless endpoint ID per model
RUNPOD_API_KEY=
RUNPOD_ANIMATEDIFF_ENDPOINT_ID=
RUNPOD_HUNYUAN_ENDPOINT_ID=
RUNPOD_DEFORUM_ENDPOINT_ID=
# used by the enhance queue
RUNPOD_UPREZ_ENDPOINT_ID=
RUNPOD_LTX_ENDPOINT_ID=
RUNPOD_NVIDIA_SR_ENDPOINT_ID=
RUNPOD_VIDEOINGEST_ENDPOINT_ID=
RUNPOD_DISCODIFFUSION_ENDPOINT_ID=

# Cloudflare R2
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_DIRECTORY=video-outputs
R2_IMAGE_DIRECTORY=image-inputs
R2_PRESIGNED_EXPIRY=86400

IMAGE_INGEST_CONCURRENCY=2
WORKER_URL=http://localhost:3000

# Bull Board admin UI (user: admin)
ADMIN_PASS=

# Marketing email CLI
MARKETING_EMAIL_SECRET=
MARKETING_QUEUE_NAME=marketing-email
MARKETING_CONCURRENCY=10
MARKETING_RATE_LIMIT_PER_SECOND=6
